<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                     Title="{Loc 'destructive-analyzer-menu-title'}"
                     MinSize="420 280"
                     SetSize="420 280">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="10">
        <Button Name="ServerButton"
                Text="{Loc 'destructive-analyzer-menu-server-button'}"
                HorizontalAlignment="Left"/>
        <PanelContainer Margin="0 10 0 0" VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#000000FF"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical"
                          VerticalExpand="True"
                          HorizontalExpand="True"
                          Margin="12"
                          SeparationOverride="6">
                <RichTextLabel Name="PointsLabel" HorizontalAlignment="Center"/>
                <RichTextLabel Name="StatusLabel" HorizontalAlignment="Center"/>
                <RichTextLabel Name="ItemLabel" HorizontalAlignment="Center"/>
                <RichTextLabel Name="ValueLabel" HorizontalAlignment="Center"/>
                <BoxContainer MinHeight="12"/>
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
                    <Button Name="AnalyzeButton"
                            Text="{Loc 'destructive-analyzer-menu-analyze-button'}"
                            MinWidth="120"/>
                    <Button Name="EjectButton"
                            Text="{Loc 'destructive-analyzer-menu-eject-button'}"
                            MinWidth="120"/>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
