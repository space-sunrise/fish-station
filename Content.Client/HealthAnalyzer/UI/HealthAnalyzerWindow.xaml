<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client.HealthAnalyzer.UI"
    StyleClasses="HealthAnalyzerWindow"
    HeaderClass="HealthAnalyzerWindowHeader"
    TitleClass="HealthAnalyzerWindowTitle"
    SetSize="520 680"
    MinSize="420 520"
    MaxHeight="800">
    <!-- FIsh edit start - декоративные эффекты интерфейса сканера -->
    <LayoutContainer
        Name="AnalyzerLayout"
        HorizontalExpand="True"
        VerticalExpand="True">

        <ScrollContainer
            Name="AnalyzerScroll"
            Margin="5 5 5 5"
            HScrollEnabled="False"
            ReserveScrollbarSpace="True"
            VerticalExpand="True">

            <ui:HealthAnalyzerControl
                Name="HealthAnalyzer"
                HorizontalExpand="True"/>
        </ScrollContainer>

        <ui:HealthAnalyzerEffects
            Name="EffectsLayer"
            RectClipContent="True"/>
    </LayoutContainer>
    <!-- FIsh edit end -->
</controls:FancyWindow>
