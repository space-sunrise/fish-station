<BoxContainer
    xmlns="https://spacestation14.io"
    VerticalExpand="True"
    MinWidth="360"
    Orientation="Vertical"
    SeparationOverride="8">
    <PanelContainer
        Name="NoPatientDataPanel"
        StyleClasses="HealthAnalyzerEmptyCard">
        <Label
            Name="NoPatientDataText"
            Margin="10"
            HorizontalAlignment="Center"
            Text="{Loc health-analyzer-window-no-patient-data-text}"
            StyleClasses="LabelSubText" />
    </PanelContainer>

    <BoxContainer
        Name="PatientDataContainer"
        Visible="False"
        Orientation="Vertical"
        SeparationOverride="8">
        <PanelContainer StyleClasses="HealthAnalyzerHeaderCard">
            <BoxContainer
                Margin="10 8"
                Orientation="Horizontal"
                SeparationOverride="10">
                <PanelContainer StyleClasses="HealthAnalyzerPortraitFrame">
                    <Control SetSize="64 64">
                        <SpriteView
                            Name="SpriteView"
                            Access="Public"
                            OverrideDirection="South"
                            Scale="2 2"
                            SetSize="64 64" />
                        <TextureRect
                            Name="NoDataTex"
                            Access="Public"
                            Visible="False"
                            SetSize="64 64"
                            Stretch="KeepAspectCentered"
                            TexturePath="/Textures/Interface/Misc/health_analyzer_out_of_range.png" />
                    </Control>
                </PanelContainer>

                <BoxContainer
                    Orientation="Vertical"
                    HorizontalExpand="True"
                    VerticalAlignment="Center"
                    SeparationOverride="2">
                    <Label
                        Name="NameLabel"
                        HorizontalExpand="True"
                        MaxWidth="185"
                        StyleClasses="HealthAnalyzerPatientName" />
                    <Label
                        Name="SpeciesLabel"
                        StyleClasses="LabelSubText" />
                </BoxContainer>

                <BoxContainer
                    Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    SeparationOverride="2">
                    <Label
                        Name="StatusLabel"
                        HorizontalAlignment="Right"
                        StyleClasses="HealthAnalyzerStatus" />
                    <Label
                        Text="{Loc 'health-analyzer-window-scan-mode-text'}"
                        HorizontalAlignment="Right"
                        StyleClasses="HealthAnalyzerMetricKey" />
                    <Label
                        Name="ScanModeLabel"
                        Text="{Loc 'health-analyzer-window-entity-unknown-text'}"
                        HorizontalAlignment="Right"
                        StyleClasses="HealthAnalyzerScanMode" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <Label
            Text="{Loc 'health-analyzer-window-vitals-title'}"
            StyleClasses="HealthAnalyzerSectionTitle" />

        <GridContainer
            Columns="2"
            HSeparationOverride="6"
            VSeparationOverride="6">
            <PanelContainer HorizontalExpand="True" StyleClasses="HealthAnalyzerMetricCard">
                <BoxContainer Margin="8 5" Orientation="Vertical">
                    <Label
                        Text="{Loc 'health-analyzer-window-entity-temperature-text'}"
                        StyleClasses="HealthAnalyzerMetricKey" />
                    <Label
                        Name="TemperatureLabel"
                        StyleClasses="HealthAnalyzerMetricValue" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" StyleClasses="HealthAnalyzerMetricCard">
                <BoxContainer Margin="8 5" Orientation="Vertical">
                    <Label
                        Text="{Loc 'health-analyzer-window-entity-blood-level-text'}"
                        StyleClasses="HealthAnalyzerMetricKey" />
                    <Label
                        Name="BloodLabel"
                        StyleClasses="HealthAnalyzerMetricValue" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" StyleClasses="HealthAnalyzerMetricCard">
                <BoxContainer Margin="8 5" Orientation="Vertical">
                    <Label
                        Text="{Loc 'health-analyzer-window-entity-damage-total-text'}"
                        StyleClasses="HealthAnalyzerMetricKey" />
                    <Label
                        Name="DamageLabel"
                        StyleClasses="HealthAnalyzerMetricValue" />
                </BoxContainer>
            </PanelContainer>

            <!-- Sunrise-Edit start - hunger and thirst labels -->
            <PanelContainer HorizontalExpand="True" StyleClasses="HealthAnalyzerMetricCard">
                <BoxContainer
                    Margin="8 5"
                    Orientation="Horizontal"
                    SeparationOverride="10">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label
                            Text="{Loc 'health-analyzer-window-entity-hunger-level-text'}"
                            StyleClasses="HealthAnalyzerMetricKey" />
                        <Label
                            Name="HungerLabel"
                            StyleClasses="HealthAnalyzerMetricValue" />
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label
                            Text="{Loc 'health-analyzer-window-entity-thirst-level-text'}"
                            StyleClasses="HealthAnalyzerMetricKey" />
                        <Label
                            Name="ThirstLabel"
                            StyleClasses="HealthAnalyzerMetricValue" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
            <!-- Sunrise-Edit end -->
        </GridContainer>
    </BoxContainer>

    <PanelContainer
        Name="AlertsContainer"
        Visible="False"
        StyleClasses="HealthAnalyzerAlertCard">
        <BoxContainer
            Name="AlertsListContainer"
            Margin="9 5"
            Orientation="Vertical" />
    </PanelContainer>

    <PanelContainer
        Name="DamageContainer"
        Visible="False"
        StyleClasses="HealthAnalyzerCard">
        <BoxContainer
            Margin="9 7"
            Orientation="Vertical"
            SeparationOverride="3">
            <Label
                Text="{Loc 'health-analyzer-window-damage-title'}"
                StyleClasses="HealthAnalyzerSectionTitle" />
            <BoxContainer
                Name="GroupsContainer"
                Orientation="Vertical" />
        </BoxContainer>
    </PanelContainer>

    <!-- FIsh edit start - помощник лечения и реагенты в кровотоке -->
    <PanelContainer
        Name="TreatmentContainer"
        Visible="False"
        StyleClasses="HealthAnalyzerTreatmentCard">
        <BoxContainer
            Margin="9 7"
            Orientation="Vertical"
            SeparationOverride="4">
            <Label
                Text="{Loc 'health-analyzer-window-treatment-title'}"
                StyleClasses="HealthAnalyzerSectionTitle" />
            <BoxContainer
                Name="TreatmentListContainer"
                Orientation="Vertical"
                SeparationOverride="4" />
        </BoxContainer>
    </PanelContainer>

    <PanelContainer
        Name="ReagentsContainer"
        Visible="False"
        StyleClasses="HealthAnalyzerCard">
        <BoxContainer
            Margin="9 7"
            Orientation="Vertical"
            SeparationOverride="4">
            <Label
                Text="{Loc 'health-analyzer-window-reagents-title'}"
                StyleClasses="HealthAnalyzerSectionTitle" />
            <BoxContainer
                Name="ReagentsListContainer"
                Orientation="Vertical"
                SeparationOverride="2" />
        </BoxContainer>
    </PanelContainer>
    <!-- FIsh edit end -->
</BoxContainer>
