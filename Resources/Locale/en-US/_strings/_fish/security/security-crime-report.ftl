security-crime-report-menu-article = {$code} — {$title}

# Radio (markup): stands out from normal Security channel chatter
security-crime-report-message = [bold][color=#ff6b6b]SEC REPORT:[/color][/bold] [bold]{$code}[/bold] — {$title} — [color=#ffd666]{$location}[/color]
security-crime-report-message-backup = [bold][color=#ff2222]SEC REPORT:[/color][/bold] [bold]{$code}[/bold] — {$title} — [color=#ffd666]{$location}[/color] — [bold][color=#ffaa00]⚠ Backup required[/color][/bold]
security-crime-report-message-malfunction = [bold][color=#ff6b6b]SEC REPORT:[/color][/bold] [bold]{$code}[/bold] — {$title}
security-crime-report-message-malfunction-backup = [bold][color=#ff2222]SEC REPORT:[/color][/bold] [bold]{$code}[/bold] — {$title} — [bold][color=#ffaa00]⚠ Backup required[/color][/bold]

# Messenger / plain text without markup
security-crime-report-message-plain = SEC REPORT: {$code} — {$title} — {$location}
security-crime-report-message-plain-backup = SEC REPORT: {$code} — {$title} — {$location} — ⚠ Backup required
security-crime-report-message-malfunction-plain = SEC REPORT: {$code} — {$title}
security-crime-report-message-malfunction-plain-backup = SEC REPORT: {$code} — {$title} — ⚠ Backup required

security-crime-report-interference = *** SIGNAL INTERFERENCE ***
security-crime-report-chat-notification = Attention! Security crime report: {$source}
security-crime-report-chat-notification-urgent = ⚠ URGENT! Security crime report, backup required: {$source}

ent-ActionSecurityCrimeReport = report crime
    .desc = Open a radial menu to announce a Space Law article on the security channel.
